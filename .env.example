# Biến môi trường của Colori. Copy file này thành `.env` (không đưa lên git) rồi điền giá trị.
# Expo CLI tự nạp `.env` khi chạy `npm start`; app.config.js đọc rồi đưa vào `extra`,
# code đọc lại qua src/config.ts. Sửa `.env` xong phải khởi động lại `npm start`.
#
# App không có server/API nên ở đây KHÔNG có khoá bí mật. Biến để trống thì dùng giá trị mặc định.
# Khi build trên EAS (giai đoạn B): `.env` bị .gitignore nên không được gửi lên, phải khai các
# biến này trong `env` của eas.json hoặc EAS environment variables (F10).

# ---- Môi trường -----------------------------------------------------------------------------
# development | preview | store-test | production. Local mặc định development.
# Bản build EAS lấy từ eas.json (biến có sẵn trong process.env không bị .env ghi đè).
APP_ENV=development

# ---- Link ngoài ở màn Thông tin (S11) – Q12 ------------------------------------------------
# Để trống: dùng giá trị tạm example.com (A32). `npm run check:release` báo lỗi khi còn giá trị tạm.
PRIVACY_URL=
CONTACT_EMAIL=
# Mã số app trên App Store (chỉ số), có sau khi tạo app trên App Store Connect. Dùng cho "Đánh giá app" trên iOS.
IOS_APP_STORE_ID=

# ---- AdMob (P6) ------------------------------------------------------------------------------
# Chỉ đọc khi APP_ENV=production. Mọi bản khác (Expo Go, development, preview, store-test) luôn
# dùng App ID mẫu + Test Ad ID của Google, bất kể giá trị ở đây (F06).
# Bản production thiếu một trong 4 ID (hoặc còn ID test) thì app.config.js báo lỗi, không build.
ADMOB_APP_ID_IOS=
ADMOB_APP_ID_ANDROID=
ADMOB_INTERSTITIAL_IOS=
ADMOB_INTERSTITIAL_ANDROID=

# ---- Firebase (P7) ---------------------------------------------------------------------------
# Đường dẫn tới 2 file cấu hình Firebase (file thật không đưa lên git, F07). Trên EAS khai bằng
# biến môi trường kiểu "file" cùng tên.
# - Có đủ 2 file: bản build có Firebase (Analytics + Crashlytics).
# - Thiếu file: bản development / preview / store-test build không có Firebase (không gửi gì);
#   APP_ENV=production thì app.config.js báo lỗi, không build. Expo Go không cần 2 file này.
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
GOOGLE_SERVICES_JSON=./google-services.json
