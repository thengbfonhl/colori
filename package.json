{
  "name": "colori",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "start:tunnel": "expo start --go --tunnel",
    "art:build": "node scripts/build-artworks.mjs",
    "sounds:build": "node scripts/build-sounds.mjs",
    "oss:build": "node scripts/gen-oss-notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "licenses": "node scripts/check-licenses.mjs --list",
    "check": "node scripts/build-artworks.mjs --check && node scripts/check-licenses.mjs && node scripts/gen-oss-notices.mjs --check && node --test --test-reporter=dot \"scripts/__tests__/*.test.mjs\" && tsc --noEmit && jest",
    "check:release": "npm run check && node scripts/check-release.mjs",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile store-test",
    "build:prod": "eas build -p all --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^27.1.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/crashlytics": "^27.1.1",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "^58.0.0",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.14",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
