{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_ENV": "preview" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "store-test": {
      "distribution": "store",
      "env": { "APP_ENV": "store-test" },
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": false,
      "env": { "APP_ENV": "production" },
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false }
    }
  },
  "submit": {
    "production": {}
  }
}
